# Copy to .env and fill in real values. Never commit .env.

# ── LLM ────────────────────────────────────────────────────────────────
# External channel (dev/smoke): openai provider, config/llm/deepseek-v4-flash.yaml
DASHSCOPE_API_KEY=
# Placeholder required by pyserini's eager OpenAI client import (any value)
OPENAI_API_KEY=pyserini-bm25-placeholder
# JDK 21 home — required by PySerini BM25 (the image installs openjdk-21)
JAVA_HOME=

# ── Embedding / parsing (read by the vendored chillrag engine) ─────────
MODELS_DIR=
EMBED_MODEL=
EMBED_DEVICE=cpu
MINERU_BACKEND=pipeline
# Offline/intranet: MinerU must load bundled models instead of downloading
MINERU_MODEL_SOURCE=local
# Per-条 chunk granularity: title level <= CHUNK_LEVEL opens a chunk
# (编=1 章=2 节=3 条=4 as leveled by compare.headings; 4 = every 第X条 indexed).
CHUNK_LEVEL=4

# ── Service ────────────────────────────────────────────────────────────
# Artifact + database root (relative to repo or absolute)
DATA_DIR=data
# Static API key for X-API-Key auth; empty = auth disabled
API_KEY=
# Comma-separated CORS whitelist; empty = same-origin only
CORS_ORIGINS=
# Job runner worker count. Keep 1 on the intranet: chains run serially so the
# total in-flight LLM requests = COMPARE_CONCURRENCY (qwen3.8-27b has 2 slots).
JOB_WORKERS=1
# Upload size cap (MB)
MAX_UPLOAD_MB=200
# Document-level applicability judgment input cap (chars)
APPLICABILITY_MAX_CHARS=30000
# Dev fallback for the result callback (plain POST); the ESG gateway below
# takes precedence when configured. Empty = callback disabled.
BACKEND_CALLBACK_URL=
# How pushed regulations reach the chain: auto | cron | immediate
# (auto = OptType 0/manual pushes run immediately, the rest wait for cron)
CHAIN_DISPATCH=auto
# 5-field crontab admitting scheduled chain jobs
CHAIN_CRON=0 20 * * mon-sat
# ESG open-platform gateway (result callback); empty ESG_OPEN_END_POINT = off
ESG_AUTH_END_POINT=
ESG_OPEN_END_POINT=
ESG_CLIENT_ID=
ESG_CLIENT_SECRET=
ESG_CALLBACK_PATH=/paerm/paermModelReturn

# ── Engines ────────────────────────────────────────────────────────────
# LLM fan-out per chain; 2 = the intranet model's concurrent slots.
COMPARE_CONCURRENCY=2
EPISODE_TIMEOUT_S=600
LLM_TIMEOUT_S=180
MAX_TOOL_CALLS=15
SEARCH_TOP_K=10
REVIEW_TOP_K=10
SEARCHER=hybrid
LOG_LEVEL=INFO
